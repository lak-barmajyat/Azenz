import QmlProject 1.3

Project {
    mainFile: "qml/App.qml"

    importPaths: [ ".", "qml" ]
    qt6Project: true
    QmlFiles { directory: "qml" }
    QmlFiles { directory: "modules" }
    JavaScriptFiles { directory: "qml" }
    JavaScriptFiles { directory: "modules" }
    ImageFiles { directory: "resources/images" }
    Files { directory: "qml"; filter: "qmldir;*.metainfo" }
    Files { directory: "resources/fonts"; filter: "*.ttf;*.txt" }
}
